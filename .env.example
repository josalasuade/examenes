# Copiar a .env y completar. El archivo .env NO se sube al repo.
# En producción (Vercel) estas variables se cargan en el panel del proyecto.

# Base de datos (local con docker compose: no hace falta tocarla).
# En Supabase: Project Settings → Database → Connection string (pooler, modo transacción).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/examenes

# URL pública de la app, sin barra final. Se usa para validar SEB y las cookies.
APP_URL=http://localhost:3000

# Contraseña del panel docente (/admin).
ADMIN_PASSWORD=cambiar-esta-clave

# Secreto para firmar la sesión del docente: 32+ caracteres al azar.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Mail. Local: Mailpit (docker compose) → localhost:1025, sin usuario.
# Producción con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=<tu cuenta>, SMTP_PASS=<contraseña de aplicación de Google>.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Examenes <examenes@localhost>"

# Opcional: zona horaria para fechas en PDF y mails.
# ZONA_HORARIA=America/Argentina/Buenos_Aires
